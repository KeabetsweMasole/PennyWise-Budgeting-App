<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The dark mode version of the app's main theme -->
    <style name="Theme.Navigation" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Main colors adjusted to look better on dark backgrounds -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary accent colors for dark mode -->
        <item name="colorSecondary">@color/secondary_green</item>
        <item name="colorSecondaryVariant">@color/secondary_green</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surface and Background colors for Dark Mode -->
        <item name="android:windowBackground">@color/background_gray</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Status bar color settings for dark mode -->
        <item name="android:statusBarColor">@color/primary_blue_dark</item>
        <item name="android:navigationBarColor">@color/background_gray</item>

        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
